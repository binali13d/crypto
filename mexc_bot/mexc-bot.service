# systemd unit — انسخه إلى /etc/systemd/system/mexc-bot.service
[Unit]
Description=MEXC Futures Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/crypto/mexc_bot
ExecStart=/home/ubuntu/crypto/mexc_bot/.venv/bin/python -m bot
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
